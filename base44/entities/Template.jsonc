    },
    "prompt": {
      "type": "string",
      "description": "Prompt do template"
    },
    "thumbnail": {
      "type": "string",
      "description": "Imagem de exemplo"
    }
  },
  "required": [
    "name",
    "category",
    "prompt"
  ]
}